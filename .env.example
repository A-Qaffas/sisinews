# sisi.news environment template, written for PRODUCTION.
#
# On the server:  cp .env.example .env  ->  fill the blanks  ->  php artisan key:generate
# The real .env holds secrets: never commit it, never paste it in a chat or a ticket.
#
# Local development (Laragon): change APP_ENV=local, APP_DEBUG=true, APP_URL=http://127.0.0.1:8000,
# LOG_LEVEL=debug and the DB_* block to your local MySQL (user root, empty password).

# --- Application -----------------------------------------------------------------------------
APP_NAME="sisi.news"
APP_ENV=production
# Filled in by `php artisan key:generate`. Generate it once: a new key signs every staff member out.
APP_KEY=
# Must stay false on the live site: with true, an error page shows readers the code and settings.
APP_DEBUG=false
# Uploaded pictures are linked as {APP_URL}/storage/..., so this must be exactly what a browser
# types. While the site is still on plain http (no certificate yet) write http://sisi.news here and
# switch to https together with APP_FORCE_HTTPS below.
APP_URL=https://sisi.news

# Public site language. "/" goes to /ar, or to /en for browsers that prefer English.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
# (The staff panel is always English, whatever APP_LOCALE says.)

# Password hashing cost. Leave at 12: lower is faster to guess, higher slows every sign-in on a shared 1 vCPU host.
BCRYPT_ROUNDS=12

# --- HTTPS switch ----------------------------------------------------------------------------
# false: links and redirects follow the address the visitor used (http works).
# true: every generated link is https. Turn it on only once https://sisi.news opens with a valid
# certificate; the two lines below change together.
APP_FORCE_HTTPS=false
# true marks the login cookie "secure". With true on a plain-http site nobody can sign in,
# because the browser refuses to send the cookie back. Keep it false until https works.
SESSION_SECURE_COOKIE=false
# How long (seconds) a browser that has seen https://sisi.news refuses plain http for it. Sent only over
# https. One week by default so a certificate mistake can be walked back; once https has been stable for
# a while raise it (2592000 = 30 days, 31536000 = a year). 0 makes browsers forget the rule.
SECURITY_HSTS_MAX_AGE=604800

# --- Logging ---------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# warning keeps storage/logs small on the shared host; use debug only while hunting a problem.
LOG_LEVEL=warning

# --- Database (cPanel MariaDB 10.11) ---------------------------------------------------------
DB_CONNECTION=mysql
# cPanel databases are local to the account. If 127.0.0.1 is refused, try localhost.
DB_HOST=127.0.0.1
DB_PORT=3306
# cPanel prefixes database and user names with the account name (example: account_sisi).
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sessions, cache, queue ------------------------------------------------------------------
# File-based on purpose: no extra tables, no Redis on this host. Jobs run inline (no worker).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
APP_MAINTENANCE_DRIVER=file

# --- Mail ------------------------------------------------------------------------------------
# v1 sends no email (no registration, no password reset by email, the newsletter only stores
# addresses). "log" writes any message to the log instead of sending it.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@sisi.news"
MAIL_FROM_NAME="${APP_NAME}"

# --- Public site details (all optional: a blank value hides that link in the footer) ---------
SITE_SOCIAL_FACEBOOK=
SITE_SOCIAL_X=
SITE_SOCIAL_INSTAGRAM=
SITE_SOCIAL_YOUTUBE=
SITE_CONTACT_EMAIL=
SITE_CONTACT_PHONE=
